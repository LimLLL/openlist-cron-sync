# openlist-cron-sync 本地开发配置示例。
# 使用方法：复制为 .env（已被 git 忽略），按需修改后运行 `pnpm run start:dev`。
# 服务只在 NODE_ENV=development 时读取 .env；start:dev / start:debug 脚本已设置该值。
# 运行构建产物时可用 Node 自带参数加载：`node --env-file=.env dist/main.js`。
# 生产环境不要使用 .env，直接通过环境变量配置，完整说明见 docs/reference/configuration.md。

NODE_ENV=development

# 监听地址与端口；本地开发只监听本机。
HOST=127.0.0.1
PORT=39123

# 数据目录，必须是绝对路径。推荐指向仓库下的 .data/（已被 git 忽略）。
DATA_DIR=/absolute/path/to/openlist-cron-sync/.data
# 传输缓冲目录，默认 DATA_DIR/spool。
# SPOOL_DIR=
# RELAY_DOWNLOAD_WORKERS=4
# RELAY_UPLOAD_WORKERS=8
# SPOOL_RESERVE_BYTES=536870912
# SHUTDOWN_GRACE_SECONDS=30

# 日志级别：error / warn / info / debug。
LOG_LEVEL=debug

# 是否提供 /api/v1/docs 与 /api/v1/openapi.json。
API_DOCS_ENABLED=true

# 首次启动（数据库中没有管理员）时创建的管理员；之后修改这两项不再生效。
# 密码 12–128 个字符；不设置则随机生成并在 stderr 打印一次。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-password

# 密钥：32 字节、标准 base64 编码。不设置时自动生成并保存到 DATA_DIR/keys.json。
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# JWT_SECRET=
# ENCRYPTION_MASTER_KEY=

# 登录令牌有效期（秒）。
# ADMIN_JWT_TTL_SECONDS=28800

# 登录限流：计数窗口（秒）内允许的失败次数。
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900

# 服务前面可信反向代理的层数；本地直连保持 0。
# TRUST_PROXY_HOPS=0

# 访问 OpenList：建连超时与单次管理请求期限（毫秒）、读取重试、登录限流后的冷却（秒）、响应大小上限（字节）。
# OPENLIST_CONNECT_TIMEOUT_MS=10000
# OPENLIST_API_TIMEOUT_MS=30000
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_MS=1000
# RETRY_MAX_MS=30000
# OPENLIST_AUTH_COOLDOWN_SECONDS=600
# OPENLIST_MAX_JSON_BYTES=33554432

# 集成测试（pnpm test:integration）连接的真实 OpenList，只能指向临时测试实例。
# 服务本身不读取这些变量；OpenList 实例通过 /api/v1/instances 添加。含义见 docs/development/testing.md。
# OPENLIST_IT_BASE_URL=http://127.0.0.1:5244
# OPENLIST_IT_ADMIN_TOKEN=
# OPENLIST_IT_USERNAME=
# OPENLIST_IT_PASSWORD=
# OPENLIST_IT_LOCAL_PATH=/a
# OPENLIST_IT_SECOND_LOCAL_PATH=/b
# OPENLIST_IT_PEER_BASE_URL=http://127.0.0.1:5245
# OPENLIST_IT_PEER_ADMIN_TOKEN=
# OPENLIST_IT_PEER_LOCAL_PATH=/a
