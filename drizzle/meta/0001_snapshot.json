        },
        "instances_username": {
          "name": "instances_username",
          "value": "(\"instances\".\"auth_mode\" = 'token' AND \"instances\".\"username\" IS NULL) OR (\"instances\".\"auth_mode\" = 'password' AND length(\"instances\".\"username\") > 0 AND \"instances\".\"username\" IS NOT NULL)"
